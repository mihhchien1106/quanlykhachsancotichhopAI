# Copy this file to backend/.env and put a NEW key there.
# The key visible in your screenshot should be revoked first.
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_NEW_GEMINI_KEY
AI_MODEL=gemini-2.5-flash
PORT=4000
# Alternative for OpenAI:
# AI_PROVIDER=openai
# OPENAI_API_KEY=YOUR_OPENAI_KEY
# AI_MODEL=gpt-4.1-mini

# Optional: real confirmation/reset emails (run `npm install` in backend)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=YOUR_APP_PASSWORD
# SMTP_FROM=Grand Hotel <your-email@gmail.com>
# Without SMTP credentials, confirmation/reset links are printed to server terminal for local testing.
